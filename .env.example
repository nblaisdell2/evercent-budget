# Copy to .env for local development — or just run `npm run setup`, which
# writes this file for you (it prompts for the password).
#
# Local Postgres (e.g. `docker run --name pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16`):
DATABASE_URL=

# "disable" for a local Postgres and for Railway's private network.
# "require" only when connecting through Railway's public TCP proxy
# (see "Reaching the database from your laptop" in the README).
DATABASE_SSL=

# On Railway you do NOT set these by hand: .railway/railway.ts wires
# DATABASE_URL to the Postgres service and sets DATABASE_SSL=disable.\


# Clerk keys for local development (EverCent app, Development instance).
# Copy both from dashboard.clerk.com -> EverCent -> Configure -> API keys.
# This file is gitignored; never commit it. `npm run setup` rewrites .env, but
# never touches this file, so the keys live here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sentry: where errors are sent (public, not a secret). Remove to turn Sentry off locally.
NEXT_PUBLIC_SENTRY_DSN=

E2E_CLERK_USER_EMAIL=