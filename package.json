{
  "name": "evercent-budget",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "migrate": "node --env-file-if-exists=.env db/migrate.mjs",
    "db:types": "kysely-codegen",
    "db:ensure": "node --env-file-if-exists=.env db/ensure-database.mjs",
    "setup": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-local.ps1",
    "template:init": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/init-from-template.ps1",
    "railway:setup": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-railway.ps1",
    "railway:deploy": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/railway-deploy.ps1",
    "railway:migrate": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/railway-migrate.ps1",
    "railway:domain": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/railway-domain.ps1",
    "railway:destroy": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/railway-destroy.ps1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.10.0",
    "@clerk/ui": "^1.42.6",
    "@sentry/nextjs": "11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.29.7",
    "motion": "^14.9.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.53",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^29.1.1",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "railway": "^3.16.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
